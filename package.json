{
  "name": "@adobe/aem-boilerplate",
  "private": true,
  "version": "1.3.0",
  "description": "Starter project for Adobe Helix",
  "scripts": {
    "dev": "npm-run-all -p dev:compose dev:aem",
    "dev:compose": "node dev/compose-server.mjs",
    "dev:aem": "npx -y @adobe/aem-cli up --no-open --forward-browser-logs --url http://localhost:4000",
    "test:ssr": "npm --prefix ssr test",
    "test:edge": "npm --prefix edge test",
    "ssr:deploy": "npm --prefix ssr run deploy",
    "ssr:wire": "node ssr/scripts/wire-overlay.mjs",
    "eds:publish-product-json": "node ssr/scripts/publish-product-json.mjs",
    "eds:preview-product-json": "node ssr/scripts/publish-product-json.mjs --preview-only",
    "eds:preview-product-json:catalog": "node ssr/scripts/publish-product-json.mjs --preview-only --catalog --limit 30",
    "eds:preview-product-json:pages": "node ssr/scripts/publish-product-json.mjs --preview-only --catalog --limit 30 --pages",
    "eds:preview-product-json:dry": "node ssr/scripts/publish-product-json.mjs --preview-only --catalog --limit 30 --pages --dry-run",
    "eds:publish-product-json:catalog": "node ssr/scripts/publish-product-json.mjs --catalog --limit 30",
    "eds:publish-product-json:pages": "node ssr/scripts/publish-product-json.mjs --catalog --limit 30 --pages",
    "eds:publish-product-json:dry": "node ssr/scripts/publish-product-json.mjs --catalog --limit 30 --pages --dry-run",
    "lint:js": "eslint . --ext .json,.js,.mjs",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "lighthouse": "lhci autorun --config=lighthouserc.js",
    "lighthouse:desktop": "LIGHTHOUSE_PRESET=desktop lhci autorun --config=lighthouserc.js",
    "psi": "node scripts/psi-audit.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static && cp storybook/serve.json storybook-static/serve.json",
    "storybook:preview": "npx --yes serve storybook-static -p 6007",
    "build:json": "npm-run-all -p build:json:models build:json:definitions build:json:filters",
    "build:json:models": "merge-json-cli -i \"models/_component-models.json\" -o \"component-models.json\"",
    "build:json:definitions": "merge-json-cli -i \"models/_component-definition.json\" -o \"component-definition.json\"",
    "build:json:filters": "merge-json-cli -i \"models/_component-filters.json\" -o \"component-filters.json\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-boilerplate.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-boilerplate/issues"
  },
  "homepage": "https://github.com/adobe/aem-boilerplate#readme",
  "devDependencies": {
    "@babel/eslint-parser": "7.28.6",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/html-vite": "^8.6.14",
    "@storybook/test": "^8.6.15",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-json": "3.1.0",
    "eslint-plugin-xwalk": "github:adobe-rnd/eslint-plugin-xwalk",
    "husky": "9.1.1",
    "merge-json-cli": "1.0.4",
    "npm-run-all": "4.1.5",
    "storybook": "^8.6.14",
    "stylelint": "17.12.0",
    "stylelint-config-standard": "40.0.0",
    "vite": "^5.4.21"
  }
}
