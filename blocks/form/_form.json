  "models": [
    {
      "id": "form",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "action",
          "label": "Endpoint URL",
          "description": "URL that receives POST application/json after client-side validation. The endpoint must allow CORS from this site."
        },
        {
          "component": "textarea",
          "valueType": "string",
          "name": "successMessage",
          "label": "Success Message",
          "description": "Shown after a successful 2xx response"
        },
        {
          "component": "textarea",
          "valueType": "string",
          "name": "errorMessage",
          "label": "Error Message",
          "description": "Shown when the request fails or the endpoint returns a non-2xx status"
        }
      ]
    },
    {
      "id": "form-input",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "type",
          "label": "Field Type",
          "value": "text",
          "options": [
            { "name": "Text", "value": "text" },
            { "name": "Email", "value": "email" },
            { "name": "Telephone", "value": "tel" },
            { "name": "Textarea", "value": "textarea" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "field_label",
          "label": "Label"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "field_key",
          "label": "Name",
          "description": "JSON property name sent to the endpoint"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "field_placeholder",
          "label": "Placeholder"
        },
        {
          "component": "text",
          "valueType": "string",
