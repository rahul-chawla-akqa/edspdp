          "label": "Help Text"
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "rules_required",
          "label": "Required"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "rules_pattern",
          "label": "Validation Regex",
          "description": "Optional JavaScript regular expression. Slashes around the pattern are optional."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "rules_message",
          "label": "Validation Message",
          "description": "Shown when this field fails validation"
        }
      ]
    },
    {
      "id": "form-choice",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "type",
          "label": "Field Type",
          "value": "select",
          "options": [
            { "name": "Select", "value": "select" },
            { "name": "Radio", "value": "radio" },
            { "name": "Checkbox", "value": "checkbox" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "field_label",
          "label": "Label"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "field_key",
          "label": "Name",
          "description": "JSON property name sent to the endpoint"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "field_placeholder",
          "label": "Placeholder",
          "description": "Used as the empty option label for select fields"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "rules_hint",
          "label": "Help Text"
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "rules_required",
          "label": "Required"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "rules_pattern",
          "label": "Validation Regex",
          "description": "Optional. Applied to the selected value for select and radio fields."
