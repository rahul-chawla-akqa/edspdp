# Copy to ssr/.env and fill in. Never commit the real file.

# --- Adobe I/O Runtime credentials (from `aio console` / the Developer Console) ---
AIO_runtime_auth=
AIO_runtime_namespace=

# --- Overlay composer ---
# Primary content source: the same URL registered as content.source.url in the site config.
PRIMARY_SOURCE_URL=https://author-p104103-e1884364.adobeaemcloud.com/bin/franklin.delivery/rahul-chawla-akqa/edspdp/main
PRIMARY_SOURCE_SUFFIX=.html
FETCH_TIMEOUT_MS=2000
LOG_LEVEL=info

# --- Refresh action (re-preview/re-publish when source data changes) ---
AEM_ORG=rahul-chawla-akqa
AEM_SITE=edspdp
AEM_BRANCH=main
# Admin API token with publish rights.
AEM_ADMIN_TOKEN=
# Shared secret the caller must present as x-refresh-secret.
REFRESH_SECRET=
# How long to wait for each async bulk job. Keep below the action timeout in app.config.yaml.
JOB_TIMEOUT_MS=120000
